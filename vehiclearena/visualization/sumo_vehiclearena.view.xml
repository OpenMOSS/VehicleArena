<viewsettings>
    <scheme name="vehiclearena">
        <opengl antialiase="1" dither="0"/>
        <background backgroundColor="151,174,185" showGrid="0"/>
        <edges laneEdgeMode="0" scaleMode="0" laneShowBorders="1"
               showBikeMarkings="1" showLinkDecals="0"
               realisticLinkRules="1" showLinkRules="0" showRails="0"
               hideConnectors="1" widthExaggeration="1.00" minSize="0.00"
               showDirection="0" showSublanes="0" spreadSuperposed="0"
               disableHideByZoom="1">
            <colorScheme name="uniform">
                <entry color="82,91,98" name="road"/>
                <entry color="118,124,126" name="sidewalk"/>
                <entry color="148,101,70" name="bike lane"/>
                <entry color="137,157,139" name="green verge"/>
                <entry color="80,130,160" name="waterway"/>
                <entry color="62,68,72" name="railway"/>
                <entry color="62,68,72" name="rails on road"/>
                <entry color="92,92,92" name="no passenger"/>
                <entry color="219,78,73" name="closed"/>
                <entry color="77,86,92" name="connector"/>
                <entry color="219,78,73" name="forbidden"/>
            </colorScheme>
        </edges>
        <vehicles vehicleMode="0" vehicleScaleMode="0" vehicleQuality="2"
                  vehicle_minSize="2.50" vehicle_exaggeration="1.15"
                  vehicle_constantSize="0" vehicle_constantSizeSelected="0"
                  showBlinker="1" drawMinGap="0" drawBrakeGap="0"
                  showBTRange="0" showRouteIndex="0" scaleLength="0"
                  showParkingInfo="0">
            <colorScheme name="given vehicle/type/route color">
                <entry color="235,132,52"/>
            </colorScheme>
            <colorScheme name="uniform">
                <entry color="235,132,52"/>
            </colorScheme>
            <colorScheme name="given/assigned vehicle color">
                <entry color="235,132,52"/>
            </colorScheme>
        </vehicles>
        <persons personMode="0" personQuality="2" person_minSize="2.00"
                 person_exaggeration="1.10" person_constantSize="0"
                 person_constantSizeSelected="0"/>
        <junctions junctionMode="0" showLane2Lane="0" drawShape="1"
                   drawCrossingsAndWalkingareas="1" junction_minSize="1.00"
                   junction_exaggeration="1.00" junction_constantSize="0"
                   junction_constantSizeSelected="0">
            <colorScheme name="uniform">
                <entry color="77,86,92"/>
                <entry color="80,130,160" name="waterway"/>
                <entry color="0,0,0,0" name="railway"/>
            </colorScheme>
        </junctions>
        <legend showSizeLegend="0" showColorLegend="0"
                showVehicleColorLegend="0"/>
    </scheme>
</viewsettings>
